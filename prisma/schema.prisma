// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // NestJS app is CommonJS — emit a CJS client so the generated tree loads
  // without ESM/CJS interop errors when compiled through nest build.
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// USER MODEL
model User {
  id                     String  @id @default(uuid())
  firstName              String
  lastName               String
  username               String  @unique // Auto-generated via slugify
  email                  String  @unique // MoEST address (e.g. @oyomoest.ng)
  phoneNumber            String  @unique
  password               String
  requiresPasswordChange Boolean @default(false)

  // RBAC — single role per user (NEURON-RBAC-001 v1.1, Section 7).
  // "Role is singular; a user holds exactly one role. No multi-role assignment."
  role Role @default(LIE)

  // Geographic / directorate scoping — enforced at the SERVICE layer (RBAC Rule 3),
  // never by the guard. The guard confirms the role; the service compares these
  // claims against the record being accessed.
  assignedLga     String? // LIE: assigned LGA
  assignedZone    String? // ZONAL_COORD: assigned zone
  assignedCluster String? // INSPECT_OFFICER: assigned school cluster
  // PRINCIPAL: the single school this head is bound to. Scalar FK (DB constraint
  // added via DDL), mirroring the register tables — a principal sees/uploads for
  // exactly this school. Null for every other role.
  assignedSchoolId String?

  // SERVICE_ACCOUNT holders are flagged system accounts, not human users (RBAC Section 7).
  isServiceAccount Boolean @default(false)

  isDeleted           Boolean       @default(false)
  accountStatus       AccountStatus @default(PENDING)
  accountStatusReason String?

  // Audit Tracking (who provisioned / approved / rejected them)
  actionById    String?
  actionBy      User?   @relation("AdminActions", fields: [actionById], references: [id])
  usersActioned User[]  @relation("AdminActions")

  // Module 1 field capture — visits this inspector (LIE) is responsible for.
  visits           SchoolVisit[]           @relation("InspectorVisits")
  securityProfiles SchoolSecurityProfile[] @relation("SecurityCollected")

  // Notifications
  notifications          Notification[]          @relation("UserNotifications")
  notificationPreference NotificationPreference? @relation("UserNotificationPreference")

  // Auth / Password Reset
  refreshToken   String?
  resetOTP       String?
  resetOTPExpiry DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([actionById])
  @@index([accountStatus])
  @@index([role])
  @@index([assignedSchoolId])
}

// RBAC roles — NEURON-RBAC-001 v1.1, Section 7. A user holds exactly one role.
enum Role {
  LIE // Field inspector. LGA-scoped.
  ZONAL_COORD // Zone supervisor. Zone-scoped.
  EMIS_OFFICER // State-wide. Modules 1-4. Role class, not named-person.
  EXEC_VIEW // Dashboard read-only. Commissioner, PS, Governor, WC Chair. No media. No Module 4.
  SYS_ADMIN // Full access. ZDT only.
  INSPECT_OFFICER // [v1.1] Directorate field officer. Cluster-scoped. Workflow submit.
  HOD_APPROVE // [v1.1] Director/Deputy Director. Directorate read + dashboard. No Module 4.
  SERVICE_ACCOUNT // [v1.1] System-to-system. No human JWT. Scoped to automated routes.
  PRINCIPAL // School head. Self-registers, admin-approved, scoped to a single school. Self-service capture.
}

// Origin of a capture record. Principal-entered data is a SEPARATE submission that
// coexists with inspector-entered data for the same school+session (so the two can
// be compared/reconciled). Defaults to INSPECTOR so the existing capture flow is
// unchanged. Part of the unique key on every capture table.
enum CaptureSource {
  INSPECTOR
  PRINCIPAL
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BANNED
  REJECTED
  DEACTIVATED
}

// ─── Module 1: Field Capture ──────────────────────────────────────────────────
// Reference data (Dim_*) is pre-loaded; the LIE selects from it and captures
// against it. These models back the LIE dashboard worklist + stats.

// Dim_Session — academic session. Exactly one row should have isCurrent = true.
model Session {
  id        String    @id @default(uuid())
  name      String    @unique // e.g. "2025/2026"
  startDate DateTime?
  endDate   DateTime?
  isCurrent Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visits           SchoolVisit[]
  securityProfiles SchoolSecurityProfile[]
  periods          CapturePeriod[]

  @@index([isCurrent])
}

// A capture round WITHIN a session (e.g. a term or quarter). The SysAdmin defines
// these; exactly one per session is `isCurrent` — the live capture target. All
// capture writes go to the current period, so closed periods (`closedAt` set) are
// read-only history. Blank each period: a fresh set of capture records per period.
model CapturePeriod {
  id        String    @id @default(uuid())
  sessionId String
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name      String // e.g. "Term 1", "Q2"
  sequence  Int    @default(1) // display / chronological order within the session
  startDate DateTime?
  endDate   DateTime?
  isCurrent Boolean   @default(false)
  closedAt  DateTime? // set when a newer period is activated; marks it read-only

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, name])
  @@index([sessionId])
  @@index([isCurrent])
}

// ─── Dimension / reference tables (Field Capture Guide §1) ────────────────────
// Normalized lookups the enumerator selects from. Admin-managed. Fact tables keep
// their existing validated STRING (for display / scoring / unique keys) AND carry
// a nullable FK id to the matching dim row (set on save) for clean BI joins.

// Dim_Zone — education zone.
model Zone {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lgas Lga[]

  @@index([isActive])
}

// Dim_LGA — Local Government Area (33 in Oyo State), belongs to a zone.
model Lga {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String   @unique
  zoneId    String?
  zone      Zone?    @relation(fields: [zoneId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId])
  @@index([isActive])
}

// Dim_ClassLevel — Pry1 … SSS3, with education level + sort order.
model ClassLevel {
  id             String   @id @default(uuid())
  code           String   @unique // matches the AscRecord/StudentRecord classLevel string
  name           String
  educationLevel String? // Pre-Primary | Primary | Junior Secondary | Senior Secondary
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive])
}

// Dim_QualificationType — staff qualifications (NCE, BSc, …).
model QualificationType {
  id        String   @id @default(uuid())
  code      String   @unique // matches StaffRecord.qualification string
  name      String
  rank      Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// Dim_SubjectArea — subjects a teacher may primarily teach.
model SubjectArea {
  id        String   @id @default(uuid())
  name      String   @unique // matches StaffRecord.subject string
  category  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// Dim_MediaCategory — photo/video categories with shooting instructions.
model MediaCategory {
  id               String   @id @default(uuid())
  code             String   @unique // matches SchoolMedia.category string
  name             String
  appliesToModule  String? // Module A | B | C | D | General
  mediaTypeAllowed String   @default("image") // image | video | both
  maxFilesAllowed  Int?
  description      String? // shown to the enumerator as shooting instructions
  sortOrder        Int      @default(0) // shot-list order; codes are opaque so ordering can't come from them
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isActive])
}

enum SchoolType {
  PRIMARY
  JSS
  SSS
  COMBINED_PRY_JSS
  COMBINED_JSS_SSS
  COMBINED_PRY_SSS
}

enum SchoolOwnership {
  PUBLIC
  MISSION
  PRIVATE
}

enum SchoolCategory {
  DAY
  BOARDING
  SEMI_BOARDING
}

enum GenderCategory {
  MIXED
  BOYS_ONLY
  GIRLS_ONLY
}

// Dim_School — school master record. Pre-loaded from the registry; the LIE
// confirms/updates details and captures GPS during the visit. `lgaName` is the
// scoping key matched against User.assignedLga (RBAC Rule 3, service-layer).
model School {
  id             String          @id @default(uuid())
  code           String          @unique
  name           String
  type           SchoolType
  ownership      SchoolOwnership
  category       SchoolCategory
  genderCategory GenderCategory
  lgaName        String
  lgaCode        String?
  zoneName       String?
  // Normalized FKs to the LGA/Zone reference tables (set alongside the strings).
  lgaId          String?
  zoneId         String?
  // Inspectorate cluster — the scoping key matched against
  // User.assignedCluster for INSPECT_OFFICER (RBAC Rule 3, service-layer).
  cluster        String?
  ward           String?
  community      String?
  // Rural vs urban siting, from the Ministry's school register. Kept because
  // isolation is the single strongest driver of the vulnerability score and this
  // is the cheapest reliable signal for it.
  setting        String? // Rural | Urban / Peri-urban
  address        String?
  latitude       Float?
  longitude      Float?
  // Dim_School extras (Field Capture Guide §1.4). GPS is the one field captured
  // live at the gate; the metadata below records capture quality + supervisor sign-off.
  dateEstablished     Int? // year founded
  gpsAccuracyMetres   Float?
  gpsSampleCount      Int?
  gpsCaptureTimestamp DateTime?
  gpsVerified         Boolean   @default(false)
  isActive       Boolean         @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visits           SchoolVisit[]
  securityProfiles SchoolSecurityProfile[]

  @@index([lgaName])
  @@index([cluster])
  @@index([isActive])
  @@index([lgaId])
  @@index([zoneId])
}

// Capture lifecycle for a single section (matches the guide's
// Draft → Submitted → Verified, with NOT_STARTED for the worklist).
enum CaptureStatus {
  NOT_STARTED
  DRAFT
  SUBMITTED
  VERIFIED
}

// One row per school per session — the anchor the LIE dashboard reads for
// progress, and the parent the five capture sections will hang off later.
model SchoolVisit {
  id        String  @id @default(uuid())
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // Capture round within the session. sessionId is kept denormalized alongside.
  periodId  String

  // The LIE responsible for this visit (nullable until assigned/started).
  inspectorId String?
  inspector   User?   @relation("InspectorVisits", fields: [inspectorId], references: [id])

  // Which channel produced this visit — inspector-run or principal self-service.
  source CaptureSource @default(INSPECTOR)

  // Per-section progress (ASC, students, staff, security, media).
  ascStatus      CaptureStatus @default(NOT_STARTED)
  studentsStatus CaptureStatus @default(NOT_STARTED)
  staffStatus    CaptureStatus @default(NOT_STARTED)
  securityStatus CaptureStatus @default(NOT_STARTED)
  mediaStatus    CaptureStatus @default(NOT_STARTED)
  // Rolled-up status across the five sections, maintained by the service layer.
  overallStatus  CaptureStatus @default(NOT_STARTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, periodId, source])
  @@index([inspectorId])
  @@index([overallStatus])
  @@index([periodId])
}

// Fact_SchoolSecurity — School Security & Vulnerability Profile (Field Capture
// Guide §5). One record per school per session. Categorical fields are stored as
// strings (validated against fixed option sets in the DTO) to avoid a sprawl of
// Postgres enums. All capture fields are nullable so a partial draft can be
// saved; the submit endpoint enforces required fields and fills the computed
// scores. The five score fields + tier are never entered by the LIE.
// (isolation, infrastructure, communication, exposure, composite — plus riskTier.)
model SchoolSecurityProfile {
  id            String  @id @default(uuid())
  schoolId      String
  school        School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sessionId     String
  session       Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  periodId      String
  collectedById String?
  collectedBy   User?   @relation("SecurityCollected", fields: [collectedById], references: [id])

  source CaptureSource @default(INSPECTOR)

  // Module A0 — School Profile Confirmation. These three attributes live on the
  // School master record but are only observable at the school, so the field
  // officer confirms them here. Stored as the SchoolOwnership / SchoolCategory /
  // GenderCategory enum CODES (string-typed, per this model's convention) so the
  // submit handler can write them straight back onto School.
  ownership      String? // PUBLIC | MISSION | PRIVATE
  schoolCategory String? // DAY | BOARDING | SEMI_BOARDING
  genderCategory String? // MIXED | BOYS_ONLY | GIRLS_ONLY

  // Module A — Location & Access
  distanceToMajorRoadKm    Float?
  roadSurfaceType          String? // Tarmac | Laterite | Gravel | Footpath Only | None
  // Condition of that surface, captured separately from its material: a tarred
  // road full of potholes and a well-graded earth road are both real, and it is
  // the condition that decides whether help can actually get through.
  roadCondition            String? // Good | Fair | Poor
  estimatedTravelTimeMins  Int?
  nearestTown              String?
  forestProximity          String? // Adjacent | Near | Moderate | Distant
  forestDistanceEstimateKm Float?

  // Module B — Physical Infrastructure & Perimeter
  perimeterFenceStatus String? // None | Partial | Full
  fenceType            String? // Concrete Block | Wire Mesh | Wooden | Mixed | None
  numberOfEntryPoints  Int?
  hasFunctionalGate    Boolean?
  hasCctv              Boolean?
  hasElectricity       Boolean?
  hasSolar             Boolean?
  hasExternalLighting  Boolean?
  hasHealthFacility    Boolean?
  waterSource          String? // Piped | Borehole | Well | Rain Water | None

  // Module C — Communication & Emergency Capacity
  hasPhoneNetwork          Boolean?
  networkProvider          String? // MTN | Airtel | Glo | 9mobile | None | Multiple
  signalStrength           String? // Strong | Weak | None
  hasLandline              Boolean?
  hasRadioSet              Boolean?
  hasEmergencyProtocol     Boolean?
  distanceToSecurityPostKm Float?
  nearestSecurityPostName  String?
  hasSecurityGuard         Boolean?

  // Module D — Incident History
  hadSecurityIncident    Boolean?
  incidentCount          Int?
  mostRecentIncidentYear Int?
  mostRecentIncidentType String? // Threat | Robbery | Abduction | Physical Attack | Vandalism | Other
  incidentReportedToAuth Boolean?
  // Inspection cadence — asked of every school, not only those with an incident.
  lastInspectionDate       DateTime?
  inspectionVisitsLastYear Int?

  // Computed risk scores (set on submit, 0–100; higher = more vulnerable)
  isolationScore      Float?
  infrastructureScore Float?
  communicationScore  Float?
  // Intrinsic exposure from the Module A0 profile (boarding / gender / ownership)
  // — what the school is, as opposed to what it lacks.
  exposureScore       Float?
  compositeRiskScore  Float?
  riskTier            String? // High | Moderate | Low

  recordStatus CaptureStatus @default(DRAFT)
  submittedAt  DateTime?

  verifiedById String?
  verifiedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, periodId, source])
  @@index([sessionId])
  @@index([periodId])
  @@index([riskTier])
}

enum Gender {
  MALE
  FEMALE
}

// Append-only audit trail of consequential admin / oversight actions. Actor
// identity is snapshotted (name/role) so the entry survives user changes. Scalar
// only; no relations.
model AuditLog {
  id          String   @id @default(uuid())
  actorId     String?
  actorName   String?
  actorRole   String?
  action      String // e.g. USER_APPROVED, SECTION_VERIFIED
  targetType  String? // USER | SCHOOL | SESSION | SECTION
  targetId    String?
  targetLabel String? // human-readable (email, school name…)
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([actorId])
}

// ─── Register-type capture (multi-row) ────────────────────────────────────────
// These three are registers: many rows per school per session, unlike the single
// security profile. To keep this addition self-contained they use SCALAR foreign
// keys (no Prisma relations); referential integrity + cascade is enforced by DB
// constraints. Categorical fields are validated strings (see DTO option sets).

// Fact_ASC — Annual School Census (Field Capture Guide §2). One row per class
// level per gender per school per session.
model AscRecord {
  id            String  @id @default(uuid())
  schoolId      String
  sessionId     String
  periodId      String
  collectedById String?
  source        CaptureSource @default(INSPECTOR)

  // Idempotency key minted on the device before the row is first sent. Lets an
  // offline batch be replayed safely: a resend upserts its own row instead of
  // creating a duplicate. Null for rows created online before this existed.
  clientId String?

  classLevel     String // Pry1 … SSS3 (kept for display / unique key)
  classLevelId   String? // FK → ClassLevel (normalized, set on save)
  gender         Gender
  enrolmentCount Int    @default(0)
  newEntrants    Int    @default(0)
  repeaters      Int    @default(0)
  dropoutCount   Int    @default(0)

  // Verification provenance (Field Capture Guide — Verified_By / Verification_Date).
  verifiedById String?
  verifiedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, periodId, source, classLevel, gender])
  // Postgres treats NULLs as distinct, so pre-existing rows don't collide.
  @@unique([schoolId, periodId, source, clientId])
  @@index([schoolId, periodId])
}

// Fact_Students — Student Management Register (Field Capture Guide §3). One row
// per student per session.
model StudentRecord {
  id            String  @id @default(uuid())
  schoolId      String
  sessionId     String
  periodId      String
  collectedById String?
  source        CaptureSource @default(INSPECTOR)

  // See AscRecord.clientId — offline batch idempotency key.
  clientId String?

  studentCode  String
  classLevel   String
  classLevelId String? // FK → ClassLevel (normalized, set on save)
  firstName    String
  middleName   String?
  lastName     String
  dateOfBirth  DateTime?
  gender       Gender

  stateOfOrigin String?
  lgaOfOrigin   String?

  disabilityStatus Boolean @default(false)
  disabilityType   String?

  enrolmentType      String // New | Continuing | Returning | Transfer-In
  distanceToSchoolKm Float?
  transportMode      String? // Walking | Bicycle | Motorcycle | Vehicle | Public Transport
  guardianName       String?
  guardianPhone      String?
  enrolmentDate      DateTime?
  exitDate           DateTime?
  exitReason         String? // Dropout | Transfer-Out | Completed | Deceased | Unknown

  verifiedById String?
  verifiedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, periodId, source, studentCode])
  @@unique([schoolId, periodId, source, clientId])
  @@index([schoolId, periodId])
}

// Fact_Staff — Staff Management Register (Field Capture Guide §4). One row per
// staff member per school per session.
model StaffRecord {
  id            String  @id @default(uuid())
  schoolId      String
  sessionId     String
  periodId      String
  collectedById String?
  source        CaptureSource @default(INSPECTOR)

  // See AscRecord.clientId — offline batch idempotency key.
  clientId String?

  staffCode   String
  firstName   String
  middleName  String?
  lastName    String
  gender      Gender
  dateOfBirth DateTime?
  phoneNumber String?

  staffType      String // Teaching | Non-Teaching
  employmentType String // Permanent | Contract | NYSC | Volunteer
  qualification  String // NCE | OND | HND | BSc | BEd | PGDE | MSc | MEd | PhD | Other
  qualId         String? // FK → QualificationType (normalized, set on save)
  subject        String?
  subjectId      String? // FK → SubjectArea (normalized, set on save)

  dateOfFirstAppointment DateTime?
  datePostedToSchool     DateTime?
  isResidentInCommunity  Boolean   @default(false)
  yearsAtCurrentSchool   Int?
  isHeadTeacher          Boolean   @default(false)

  verifiedById String?
  verifiedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, periodId, source, staffCode])
  @@unique([schoolId, periodId, source, clientId])
  @@index([schoolId, periodId])
}

// Fact_SchoolMedia — School Media Capture (Field Capture Guide §6). One row per
// uploaded file (image OR video). Binary lives in Cloudinary; we store its
// public_id (for deletion + on-demand signing) + technical metadata. Scalar FKs
// like the other registers.
model SchoolMedia {
  id             String  @id @default(uuid())
  schoolId       String
  sessionId      String
  periodId       String
  uploadedById   String?
  source         CaptureSource @default(INSPECTOR)

  // See AscRecord.clientId. Matters more here than on the registers: without it
  // a replayed upload would push a SECOND copy of the same photo to Cloudinary.
  clientId String?

  category         String // Module A | Module B | Module C | Module D | General
  mediaCategoryId  String? // FK → MediaCategory (normalized, set on save)
  caption          String
  mediaType        String @default("image") // image | video

  publicId         String // Cloudinary public_id (authenticated asset)
  fileUrl          String // Deprecated: no longer persisted (always ""); URLs are signed on demand from publicId
  originalFileName String?
  format           String?
  bytes            Int?
  width            Int?
  height           Int?
  videoDurationSecs Int? // videos only
  gpsLatitude      Float? // from photo EXIF (best-effort)
  gpsLongitude     Float?
  captureTimestamp DateTime? // from photo EXIF (best-effort)

  isPrimary Boolean @default(false)

  // Supervisor lifecycle (Field Capture Guide §6).
  isFlagged    Boolean @default(false)
  flagReason   String?
  isActive     Boolean @default(true)
  verifiedById String?
  verifiedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, periodId, source, clientId])
  @@index([schoolId, sessionId])
  @@index([schoolId, periodId])
}

// Coverage marks for the media shot list.
//
// A photo proves a subject is there; this table is how its ABSENCE is recorded.
// Without it "no fire extinguisher photo" is ambiguous between "the school has
// no extinguisher" and "nobody looked" — and the checklist could only ever show
// a gap the inspector had no honest way to close. Marking absence turns a hole
// in the coverage into a finding, which is the more useful datum for a security
// assessment anyway.
//
// Keyed by source like SchoolMedia: a principal's checklist and an inspector's
// are separate passes over the same school and must not overwrite each other.
model MediaCoverage {
  id           String        @id @default(uuid())
  schoolId     String
  sessionId    String
  periodId     String
  categoryCode String // matches MediaCategory.code
  source       CaptureSource @default(INSPECTOR)

  status     String  @default("NOT_PRESENT") // NOT_PRESENT
  note       String?
  markedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, periodId, source, categoryCode])
  @@index([schoolId, sessionId])
  @@index([schoolId, periodId])
}

// ─── Notifications ────────────────────────────────────────────────────────────
//
// In-app notifications. Email is sent alongside these by NotificationsService
// (it does not read from this table); the row is the record the bell renders and
// the user marks read. Kept deliberately simple: no per-notification threading,
// no grouping — a flat, newest-first feed per user.

enum NotificationType {
  ACCOUNT_APPROVED
  ACCOUNT_REJECTED
  ACCOUNT_SUSPENDED
  ACCOUNT_BANNED
  ACCOUNT_REACTIVATED
  ACCOUNT_DEACTIVATED
  ROLE_CHANGED
  PASSWORD_RESET
  SECTION_SUBMITTED
  SECTION_VERIFIED
  SECTION_RETURNED
  MEDIA_SYNCED
  CAPTURE_PERIOD_OPENED
  CAPTURE_PERIOD_CLOSED
  SYSTEM
}

model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  type  NotificationType
  title String
  body  String
  // In-app deep link (e.g. /schools/<id>/media). Null for purely informational rows.
  link  String?

  // Whether the matching email actually went out, so support can tell "we never
  // sent it" apart from "they didn't read it".
  emailSent   Boolean   @default(false)
  emailSentAt DateTime?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// Per-user delivery preferences. A row is created lazily on first read; absent
// means "all defaults on".
model NotificationPreference {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation("UserNotificationPreference", fields: [userId], references: [id], onDelete: Cascade)

  // Account-standing changes always email regardless of this — being suspended
  // is not something a preference should be able to silence.
  emailOnCaptureActivity Boolean @default(true)
  emailOnVerification    Boolean @default(true)
  emailOnMediaSync       Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
